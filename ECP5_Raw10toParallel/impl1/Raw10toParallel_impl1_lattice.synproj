-a "ECP5UM"
-d LFE5UM-85F
-t CABGA756
-s 8

-optimization_goal Area
-bram_utilization 50
-ramstyle Auto
-romstyle auto
-dsp_utilization 80
-use_dsp 1
-use_carry_chain 1
-carry_chain_length 0
-force_gsr Auto
-resource_sharing 1
-propagate_constants 1
-remove_duplicate_regs 1
-mux_style Auto
-max_fanout 1000
-fsm_encoding_style Auto
-twr_paths 3
-fix_gated_clocks 1
-loop_limit 1950



-use_io_insertion 1
-resolve_mixed_drivers 0
-use_io_reg auto


